<% content_for :title, "New product" %>

<div class="mb-8">
	<p class="mb-2 text-sm font-semibold uppercase tracking-[0.2em] text-amber-600">Inventory</p>
	<h1 class="text-4xl font-black tracking-tight text-slate-950">New product</h1>
	<p class="mt-2 text-slate-500">Add a new item to your catalog.</p>
</div>

<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
	<%= render "form", product: @product %>
</div>

<div class="mt-6">
	<%= link_to "Back to products", products_path, class: "text-sm font-bold text-slate-600 transition hover:text-slate-950" %>
</div>
