<% if notice %>
  <p class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800"><%= notice %></p>
<% end %>

<% content_for :title, "Products" %>

<div class="mb-10 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <p class="mb-2 text-sm font-semibold uppercase tracking-[0.2em] text-amber-600">Inventory</p>
    <h1 class="text-4xl font-black tracking-tight text-slate-950">Products</h1>
    <p class="mt-2 max-w-xl text-slate-500">Keep your catalog polished, current, and ready to share.</p>
  </div>
  <%= link_to "New product", new_product_path, class: "inline-flex items-center justify-center rounded-lg bg-amber-500 px-5 py-3 text-sm font-bold text-slate-950 shadow-sm transition hover:bg-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2" %>
</div>

<div id="products" class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
  <% @products.each do |product| %>
    <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
      <%= render product %>
      <div class="mt-6 border-t border-slate-100 pt-4">
        <%= link_to "View product", product, class: "inline-flex w-full items-center justify-center rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2" %>
      </div>
    </article>
  <% end %>
</div>
