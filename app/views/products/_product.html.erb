<div id="<%= dom_id product %>" class="flex-1">
  <div class="mb-5 flex items-start justify-between gap-4">
    <div>
      <p class="mb-1 text-xs font-bold uppercase tracking-[0.16em] text-amber-600">Product</p>
      <h2 class="text-xl font-extrabold tracking-tight text-slate-950"><%= product.title %></h2>
    </div>
    <span class="shrink-0 rounded-full bg-amber-100 px-3 py-1 text-sm font-bold text-amber-800">$<%= product.price %></span>
  </div>

  <div class="mb-5 aspect-[4/3] overflow-hidden rounded-xl bg-slate-100">
    <% if product.image.attached? %>
      <%= image_tag product.image, class: "h-full w-full object-cover" %>
    <% else %>
      <div class="flex h-full items-center justify-center text-sm font-semibold text-slate-400">No image yet</div>
    <% end %>
  </div>

  <p class="line-clamp-3 text-sm leading-6 text-slate-500"><%= product.description %></p>
</div>
