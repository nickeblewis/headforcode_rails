<% content_for :title, @category.name %>
<h1 class="text-4xl font-black tracking-tight text-stone-950 dark:text-white"><%= @category.name %></h1>
<p class="mt-3 text-stone-600 dark:text-stone-300">Posts in <%= @category.name %>.</p>
<section class="mt-8 grid gap-8 md:grid-cols-2 xl:grid-cols-3"><%= render @posts %></section>
