<% content_for :title, @post.title %>

<article class="mx-auto max-w-4xl">
  <header class="text-center">
    <div class="flex flex-wrap items-center justify-center gap-3 text-sm text-stone-500 dark:text-stone-400">
      <%= link_to @post.category.name, category_posts_path(@post.category.slug), class: "font-bold text-teal-700 hover:underline dark:text-teal-300" %>
      <span>Published <%= @post.published_at&.strftime("%B %-d, %Y") %></span>
      <span><%= pluralize(@post.reading_time_minutes, "minute") %> read</span>
    </div>
    <h1 class="mt-6 text-4xl font-semibold tracking-tight text-stone-950 dark:text-white md:text-6xl"><%= @post.title %></h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-stone-600 dark:text-stone-300"><%= @post.description %></p>
    <div class="mt-6 flex flex-wrap justify-center gap-2">
      <% @post.tags.each do |tag| %>
        <%= link_to "##{tag.name}", tag_posts_path(tag.slug), class: "rounded-full bg-stone-100 px-3 py-1 text-sm font-semibold text-stone-700 hover:bg-teal-100 hover:text-teal-800 dark:bg-stone-800 dark:text-stone-200" %>
      <% end %>
    </div>
  </header>

  <% if @post.hero_image.attached? %>
    <%= image_tag @post.hero_image, class: "my-10 max-h-[500px] w-full rounded-md object-cover", alt: @post.hero_image_alt.presence || @post.title %>
  <% end %>

  <div class="prose prose-lg mx-auto max-w-none prose-stone dark:prose-invert prose-a:text-teal-700 dark:prose-a:text-teal-300">
    <%= render_post_body(@post.body) %>
  </div>

  <% if @related_posts.any? %>
    <footer class="mt-16 border-t border-stone-200 pt-8 dark:border-stone-800">
      <h2 class="text-2xl font-bold text-stone-950 dark:text-white">Related posts</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3"><%= render @related_posts %></div>
    </footer>
  <% end %>
</article>
