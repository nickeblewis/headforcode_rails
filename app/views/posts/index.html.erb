<% content_for :title, "HeadForCode" %>

<section class="rounded-2xl bg-teal-50 p-6 dark:bg-teal-950/40 md:p-10">
  <p class="text-xl font-medium leading-relaxed text-teal-950 dark:text-teal-50">We help small businesses grow with smart, modern technology.</p>
  <p class="mt-4 leading-7 text-teal-900 dark:text-teal-100">From AI-powered solutions to content management systems and bespoke web development, HeadForCode explores the tools and ideas that help digital work thrive.</p>
</section>

<div class="mt-12 flex items-end justify-between gap-6">
  <div>
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-teal-700 dark:text-teal-300">HeadForCode</p>
    <h1 class="mt-2 text-4xl font-black tracking-tight text-stone-950 dark:text-white">Latest posts</h1>
  </div>
  <%= link_to "Products", products_path, class: "hidden rounded-lg border border-stone-300 px-4 py-2 text-sm font-bold text-stone-700 hover:border-teal-600 hover:text-teal-700 dark:border-stone-700 dark:text-stone-200 sm:inline-flex" %>
</div>

<div class="mt-6 flex flex-wrap gap-2">
  <% Category.order(:name).each do |category| %>
    <%= link_to category.name, category_posts_path(category.slug), class: "rounded-full bg-stone-100 px-3 py-1.5 text-sm font-semibold text-stone-700 hover:bg-teal-100 hover:text-teal-800 dark:bg-stone-800 dark:text-stone-200 dark:hover:bg-teal-950 dark:hover:text-teal-200" %>
  <% end %>
</div>

<section class="mt-8 grid gap-8 md:grid-cols-2 xl:grid-cols-3">
  <%= render @posts %>
</section>
